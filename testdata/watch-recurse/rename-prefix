# Previously renaming "/a" would also remove a watch for "/ab".
require recurse

mkdir -p /a/sub
mkdir -p /ab/sub
watch /...

watchlist /
mv /a /x
watchlist /

Output:
	rename   /a
	create   /x ← /a

	# Windows additionally reports a write for the destination directory.
	windows:
		rename   /a
		create   /x ← /a
		write    /x
